<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ReportDesigner.UI.ViewModels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
             x:Class="ReportDesigner.UI.Views.Controls.PreviewPanelView"
             x:DataType="vm:MainViewModel">

    <Grid>
        <ScrollViewer Background="#D8D8D8">
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                    Background="White" BorderBrush="Gray" BorderThickness="1">
                <Image Name="PreviewImage" Stretch="None"/>
            </Border>
        </ScrollViewer>
        <TextBlock Text="{Binding PreviewErrorMessage}" TextWrapping="Wrap" Margin="8"
                   Foreground="Crimson" IsVisible="{Binding PreviewErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
    </Grid>

</UserControl>
