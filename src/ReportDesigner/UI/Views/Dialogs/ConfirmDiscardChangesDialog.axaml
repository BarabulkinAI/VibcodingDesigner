<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="140"
        x:Class="ReportDesigner.UI.Views.Dialogs.ConfirmDiscardChangesDialog"
        Title="ReportDesigner"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="16">
        <TextBlock Name="MessageText" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Сохранить" Click="OnSaveClick"/>
            <Button Content="Не сохранять" Click="OnDiscardClick"/>
            <Button Content="Отмена" Click="OnCancelClick" IsCancel="True"/>
        </StackPanel>
    </StackPanel>

</Window>
