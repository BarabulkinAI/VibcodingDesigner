<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="260"
        x:Class="ReportDesigner.UI.Views.Dialogs.PageSetupDialog"
        Title="Параметры страницы"
        Width="320" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="16">
        <StackPanel Spacing="6">
            <TextBlock Text="Формат" FontWeight="SemiBold"/>
            <RadioButton Name="A4RadioButton" GroupName="Format" Content="A4 (210×297 мм)"/>
            <RadioButton Name="A3RadioButton" GroupName="Format" Content="A3 (297×420 мм)"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Ориентация" FontWeight="SemiBold"/>
            <RadioButton Name="PortraitRadioButton" GroupName="Orientation" Content="Книжная"/>
            <RadioButton Name="LandscapeRadioButton" GroupName="Orientation" Content="Альбомная"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="ОК" Click="OnOkClick"/>
            <Button Content="Отмена" Click="OnCancelClick" IsCancel="True"/>
        </StackPanel>
    </StackPanel>

</Window>
